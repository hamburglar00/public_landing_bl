# Supabase (landing pública)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Revalidación: mismo valor que en el constructor (Configuración → Revalidate secret)
REVALIDATE_SECRET=

# CORS: orígenes que pueden llamar a /api/revalidate (constructor). Varios separados por coma.
# Local: http://localhost:3001
# Producción: https://tu-constructor.vercel.app
ALLOWED_ORIGINS=

# Hosts permitidos para forwarding en /api/track (CSV, case-insensitive).
# Ej: fdkjkzpjqfbaavylapun.supabase.co,script.google.com
TRACK_ALLOWED_HOSTS=

# Opcional: secreto para ejecutar POST /api/track/retry manualmente desde fuera de Supabase.
# El cron automatico valida el secreto generado en public.cron_config.tracking_retry_secret.
TRACK_RETRY_SECRET=

# Colector dual-stack opcional para obtener la IP publica (incluido IPv6) sin bloquear el CTA.
# Debe apuntar al Worker propio documentado en landing-builder/infra/meta-ip-collector.
NEXT_PUBLIC_META_IP_COLLECTOR_URL=

# Secreto HMAC compartido con el Worker. Solo servidor; nunca usar prefijo NEXT_PUBLIC_.
META_IP_PROOF_SECRET=

# Solo servidor. No anteponer NEXT_PUBLIC_ a claves privadas.
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_CHAT_ORIGIN=
INTERNAL_CHAT_GATEWAY_API_KEY=
API2_ORIGIN=
API2_GATEWAY_API_KEY=
REY_GATEWAY_ORIGIN=https://reydeases-gateway.vercel.app
REY_GATEWAY_HANDOFF_API_KEY=
# Template 7 no completa el handoff hasta que API2 publique el endpoint
# idempotente por player_id y se confirme su contrato en integrations.server.ts.
