# Supabase (landing pública)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Revalidación: mismo valor que en el constructor (Configuración → Revalidate secret)
REVALIDATE_SECRET=

# CORS: orígenes que pueden llamar a /api/revalidate (constructor). Varios separados por coma.
# Local: http://localhost:3001
# Producción: https://tu-constructor.vercel.app
ALLOWED_ORIGINS=

# Hosts permitidos para forwarding en /api/track (CSV, case-insensitive).
# Ej: fdkjkzpjqfbaavylapun.supabase.co,script.google.com
TRACK_ALLOWED_HOSTS=

# Opcional: secreto para ejecutar POST /api/track/retry manualmente desde fuera de Supabase.
# El cron automatico valida el secreto generado en public.cron_config.tracking_retry_secret.
TRACK_RETRY_SECRET=

# Colector dual-stack opcional para obtener la IP publica (incluido IPv6) sin bloquear el CTA.
# Debe apuntar al Worker propio documentado en landing-builder/infra/meta-ip-collector.
NEXT_PUBLIC_META_IP_COLLECTOR_URL=

# Secreto HMAC compartido con el Worker. Solo servidor; nunca usar prefijo NEXT_PUBLIC_.
META_IP_PROOF_SECRET=

# Solo servidor. No anteponer NEXT_PUBLIC_ a claves privadas.
SUPABASE_SERVICE_ROLE_KEY=
# Cliente de la selección aleatoria al entrar sin ruta ni landing (solo servidor).
LANDING_FALLBACK_CLIENT=goldencajeros
INTERNAL_CHAT_ORIGIN=
INTERNAL_CHAT_GATEWAY_API_KEY=
INTERNAL_CHAT_PLAYER_RESOLVE_KEY=
API2_ORIGIN=
API2_GATEWAY_API_KEY=
# Real public account creation. The legacy API2_GATEWAY_API_KEY is not used here.
API2_API_KEY=
API2_API_SECRET=
REY_GATEWAY_ORIGIN=https://www.reydeases.fun
REY_GATEWAY_HANDOFF_API_KEY=
MULTI_SKIN_GATEWAY_ORIGIN=
# Ganamos+ only. Other Multi Skin sites retain MULTI_SKIN_GATEWAY_ORIGIN.
GANAMOS_PLUS_GATEWAY_ORIGIN=https://ganamosnet.global
MULTI_SKIN_GATEWAY_HANDOFF_API_KEY=
ASES_DEL_NORTE_GATEWAY_ORIGIN=
ASES_DEL_NORTE_GATEWAY_HANDOFF_API_KEY=
GANAMOS_NET_GATEWAY_ORIGIN=
GANAMOS_NET_GATEWAY_HANDOFF_API_KEY=
TEMPLATE7_RATE_LIMIT_HMAC_KEY=

# Optional extra public landing origins for automatic session reentry.
# Configure the same comma-separated list on landing engines and gateways.
# mkt.panelbotadmin.com and landing.panelbotadmin.com are already supported.
TEMPLATE7_LANDING_ORIGINS=
